# Mereth environment variables.
# Copy to .env.local and fill in. Never commit real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# From the Supabase project settings. The service role key is SERVER-ONLY and
# must never appear in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (test mode) --- [added in step 4: Payments]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (transactional email) --- [added in step 4]
RESEND_API_KEY=
EMAIL_FROM=

# --- Webflow --- [added in step 9: Webflow sync]
# Symmetric key used to encrypt per-festival Webflow API tokens at rest.
WEBFLOW_TOKEN_ENCRYPTION_KEY=
